# FutureMemory Cart - Root Environment Variables Example
# Copy this file to .env and fill in your actual values.
# NEVER commit your actual API keys or secrets to Git.

# Google OAuth Client ID (Frontend)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Backend API URL (Frontend)
VITE_BACKEND_URL=http://localhost:5000

# Hugging Face Inference Token (Used on server side only)
# Backend reads HF_TOKEN from server/.env
HF_TOKEN=your_huggingface_access_token_here

# Supabase Storage & Client (Optional)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
